        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 40
      },
      {
        "type": "range",
        "id": "page_width",
        "label": "Ancho máximo de página",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1320
      }
    ]
  },
  {
    "name": "Contacto",
    "settings": [
      {
        "type": "text",
        "id": "whatsapp",
        "label": "WhatsApp (con prefijo)",
        "default": "+34625906339"
      },
      {
        "type": "checkbox",
        "id": "whatsapp_float",
        "label": "Botón flotante de WhatsApp",

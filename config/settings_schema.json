        "min": 500,
        "max": 900,
        "step": 100,
        "default": 700
      },
      {
        "type": "range",
        "id": "heading_width",
        "label": "Anchura de títulos",
        "min": 75,
        "max": 125,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "radius",

<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="{{ settings.color_navy }}">
<link rel="canonical" href="{{ canonical_url }}">
{%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">{%- else -%}<link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">{%- endif -%}
<title>{{ page_title }}{% if current_page != 1 %} – Página {{ current_page }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
{%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:title" content="{{ page_title | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
{%- if page_image -%}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{%- endif -%}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>:root{--navy:{{ settings.color_navy }};--accent:{{ settings.color_accent }};--red:{{ settings.color_red }};--bg:{{ settings.color_bg }};--soft:{{ settings.color_soft }};--ink:{{ settings.color_ink }};--muted:{{ settings.color_muted }};--line:{{ settings.color_line }};--radius:{{ settings.radius }}px;--btn-radius:{{ settings.btn_radius }}px;--page:{{ settings.page_width }}px;--hw:{{ settings.heading_width }}%;--hweight:{{ settings.heading_weight }}}</style>
{{ 'base.css' | asset_url | stylesheet_tag }}
<script>document.documentElement.className=document.documentElement.className.replace('no-js','js');</script>
{{ content_for_header }}
</head>
<body class="t-{{ template.name }}">
<a class="skip" href="#main">Saltar al contenido</a>
{% sections 'header-group' %}
<main id="main" role="main">{{ content_for_layout }}</main>
{% sections 'footer-group' %}
{%- if settings.whatsapp_float and settings.whatsapp != blank -%}
<a class="wa-float" href="https://wa.me/{{ settings.whatsapp | remove: '+' | remove: ' ' }}?text={{ settings.whatsapp_msg | url_encode }}" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">{% render 'icon', name: 'whatsapp' %}<span>{{ settings.whatsapp_label }}</span></a>
{%- endif -%}
<script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
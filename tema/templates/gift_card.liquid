{% layout none %}<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tarjeta regalo – {{ shop.name }}</title>{{ 'base.css' | asset_url | stylesheet_tag }}{{ content_for_header }}</head>
<body><div class="pw"><img src="{{ 'logo-yaen3d.png' | asset_url }}" alt="{{ shop.name }}" width="220" height="115"><p class="eyebrow">Tarjeta regalo</p><h1 class="h1" style="--hs:56px">{{ gift_card.balance | money }}</h1>{%- if gift_card.enabled == false or gift_card.expired -%}<p class="note note--err">Esta tarjeta no está activa.</p>{%- endif -%}<p class="mono">Código: {{ gift_card.code | format_code }}</p><a class="btn" href="{{ shop.url }}">Ir a la tienda</a></div></body></html>
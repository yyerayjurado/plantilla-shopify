<style>#shopify-section-{{ section.id }}{padding-top:{{ section.settings.padding_top | times: 0.6 | round }}px;padding-bottom:{{ section.settings.padding_bottom | times: 0.6 | round }}px}@media(min-width:750px){#shopify-section-{{ section.id }}{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}}</style>
<div class="page"><div class="coll-head"><h1 class="h1" style="--hs:48px">{{ section.settings.heading }}</h1></div>
<div class="cols-grid cols-grid--4">{%- for c in collections -%}{%- if c.handle != 'frontpage' -%}<a class="col-card reveal" href="{{ c.url }}"><div class="col-card__media">{%- if c.featured_image -%}{{ c.featured_image | image_url: width: 800 | image_tag: loading: 'lazy' }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}{%- endif -%}</div><div class="col-card__info"><span class="col-card__t">{{ c.title }}</span>{% render 'icon', name: 'arrow' %}</div></a>{%- endif -%}{%- endfor -%}</div></div>
{% schema %}
{
  "name": "Lista de colecciones",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Categorías"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen arriba",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen abajo",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}

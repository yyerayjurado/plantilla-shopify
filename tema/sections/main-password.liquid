<div class="pw"><img src="{{ 'logo-yaen3d.png' | asset_url }}" alt="{{ shop.name }}" width="260" height="136"><h1 class="h1" style="--hs:44px">{{ section.settings.heading }}</h1><p class="sub">{{ shop.password_message }}</p>
{%- form 'storefront_password', class: 'search' -%}<input type="password" name="password" placeholder="Contraseña" aria-label="Contraseña"><button class="btn" type="submit">Entrar</button>{%- if form.errors -%}<p class="note note--err">Contraseña incorrecta</p>{%- endif -%}{%- endform -%}</div>
{% schema %}
{
  "name": "Contraseña",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Abrimos muy pronto"
    }
  ]
}
{% endschema %}

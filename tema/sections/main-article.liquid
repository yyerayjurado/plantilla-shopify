<style>#shopify-section-{{ section.id }}{padding-top:{{ section.settings.padding_top | times: 0.6 | round }}px;padding-bottom:{{ section.settings.padding_bottom | times: 0.6 | round }}px}@media(min-width:750px){#shopify-section-{{ section.id }}{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}}</style>
<article class="page page--narrow"><p class="mono">{{ article.published_at | date: '%d/%m/%Y' }}</p><h1 class="h1" style="--hs:48px">{{ article.title }}</h1>{%- if article.image -%}<div class="art__img">{{ article.image | image_url: width: 1400 | image_tag }}</div>{%- endif -%}<div class="rte">{{ article.content }}</div><a class="link-arrow" href="{{ blog.url }}">← Volver</a></article>
{% schema %}
{
  "name": "Artículo",
  "settings": [
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen arriba",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen abajo",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}

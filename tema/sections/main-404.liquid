<style>#shopify-section-{{ section.id }}{padding-top:{{ section.settings.padding_top | times: 0.6 | round }}px;padding-bottom:{{ section.settings.padding_bottom | times: 0.6 | round }}px}@media(min-width:750px){#shopify-section-{{ section.id }}{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}}</style>
<div class="page page--narrow empty"><p class="eyebrow">Error 404</p><h1 class="h1" style="--hs:48px">{{ section.settings.heading }}</h1><p class="sub">{{ section.settings.text }}</p><a href="{{ routes.all_products_collection_url }}" class="btn">Ver productos</a></div>
{% schema %}
{
  "name": "404",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Esta página no existe"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Texto",
      "default": "Puede que la hayamos movido. Echa un vistazo a la tienda."
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen arriba",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen abajo",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 120
    }
  ]
}
{% endschema %}

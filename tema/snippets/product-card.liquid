<a class="card reveal" href="{{ product.url | default: '#' }}">
<div class="card__media" style="aspect-ratio:{{ ratio | default: '4/5' }}">
{%- if product.featured_media -%}
{{ product.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,900', sizes: '(min-width: 990px) 25vw, 50vw', class: 'card__img' }}
{%- if product.media[1] -%}{{ product.media[1] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,900', sizes: '(min-width: 990px) 25vw, 50vw', class: 'card__img card__img--alt' }}{%- endif -%}
{%- else -%}{{ 'product-' | append: index | default: 1 | placeholder_svg_tag: 'placeholder' }}{%- endif -%}
<div class="card__badges">
{%- if product.available == false -%}<span class="badge">Agotado</span>{%- elsif product.compare_at_price > product.price -%}<span class="badge badge--red">Oferta</span>{%- endif -%}
{%- if product.tags contains 'personalizable' -%}<span class="badge badge--light">Personalizable</span>{%- endif -%}
</div>
</div>
<div class="card__info">
<h3 class="card__title">{{ product.title | default: 'Nombre del producto' }}</h3>
{%- if product -%}{% render 'price', product: product, show_from: true %}{%- else -%}<div class="price"><span class="price__now">19,90 €</span></div>{%- endif -%}
</div>
</a>
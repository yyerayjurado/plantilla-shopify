<style>#shopify-section-{{ section.id }}{padding-top:{{ section.settings.padding_top | times: 0.6 | round }}px;padding-bottom:{{ section.settings.padding_bottom | times: 0.6 | round }}px}@media(min-width:750px){#shopify-section-{{ section.id }}{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}}</style>
<style>#shopify-section-{{ section.id }}{background:{% case section.settings.fondo %}{% when "suave" %}var(--soft){% when "marino" %}var(--navy);color:#fff{% else %}var(--bg){% endcase %}}</style>
{%- if section.settings.fondo == "marino" -%}<i class="on-dark" hidden></i>{%- endif -%}
<div class="page"><div class="sec-head" style="text-align:{{ section.settings.alineacion }}">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}{% if section.settings.heading != blank %}<h2 class="h2" style="--hs:{{ section.settings.heading_size }}px">{{ section.settings.heading }}</h2>{% endif %}{% if section.settings.subheading != blank %}<p class="sub">{{ section.settings.subheading }}</p>{% endif %}</div>
<div class="revs">{%- for block in section.blocks -%}<figure class="rev reveal" {{ block.shopify_attributes }}>
<div class="rev__stars" aria-label="{{ block.settings.stars }} de 5">{%- for i in (1..block.settings.stars) -%}{% render 'icon', name: 'star' %}{%- endfor -%}</div>
<blockquote>{{ block.settings.text }}</blockquote>
<figcaption><strong>{{ block.settings.author }}</strong>{%- if block.settings.product != blank -%}<span class="mono">{{ block.settings.product }}</span>{%- endif -%}</figcaption>
</figure>{%- endfor -%}</div>
</div>
{% schema %}
{
  "name": "Opiniones",
  "class": "sec-reviews",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Opiniones"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Lo que dicen quienes ya lo tienen"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "select",
      "id": "alineacion",
      "label": "Alineación del título",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "fondo",
      "label": "Fondo",
      "options": [
        {
          "value": "blanco",
          "label": "Blanco"
        },
        {
          "value": "suave",
          "label": "Gris suave"
        },
        {
          "value": "marino",
          "label": "Marino"
        }
      ],
      "default": "blanco"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen arriba",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen abajo",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "opinion",
      "name": "Opinión",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Estrellas",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Opinión",
          "default": "Pega aquí la opinión real de un cliente (de Instagram, WhatsApp…)."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Nombre",
          "default": "Nombre del cliente"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Producto comprado"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Opiniones",
      "blocks": [
        {
          "type": "opinion"
        },
        {
          "type": "opinion"
        },
        {
          "type": "opinion"
        }
      ]
    }
  ]
}
{% endschema %}

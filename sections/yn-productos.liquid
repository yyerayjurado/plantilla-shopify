<style>#shopify-section-{{ section.id }}{padding-top:{{ section.settings.padding_top | times: 0.6 | round }}px;padding-bottom:{{ section.settings.padding_bottom | times: 0.6 | round }}px}@media(min-width:750px){#shopify-section-{{ section.id }}{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}}</style>
<style>#shopify-section-{{ section.id }}{background:{% case section.settings.fondo %}{% when "suave" %}var(--soft){% when "marino" %}var(--navy);color:#fff{% else %}var(--bg){% endcase %}}</style>
{%- if section.settings.fondo == "marino" -%}<i class="on-dark" hidden></i>{%- endif -%}
<div class="page">
<div class="sec-row"><div class="sec-head" style="text-align:{{ section.settings.alineacion }}">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}{% if section.settings.heading != blank %}<h2 class="h2" style="--hs:{{ section.settings.heading_size }}px">{{ section.settings.heading }}</h2>{% endif %}{% if section.settings.subheading != blank %}<p class="sub">{{ section.settings.subheading }}</p>{% endif %}</div>{%- if section.settings.link_text != blank -%}<a class="link-arrow" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ section.settings.link_text }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}</div>
<div class="grid grid--{{ section.settings.cols }}">
{%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
{%- for product in section.settings.collection.products limit: section.settings.limit -%}{% render 'product-card', product: product, ratio: section.settings.ratio %}{%- endfor -%}
{%- else -%}{%- for i in (1..4) -%}{% render 'product-card', product: nil, index: i, ratio: section.settings.ratio %}{%- endfor -%}{%- endif -%}
</div>
</div>
{% schema %}
{
  "name": "Productos destacados",
  "class": "sec-products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Lo más pedido"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Regalos de Navidad"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "select",
      "id": "alineacion",
      "label": "Alineación del título",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Texto enlace",
      "default": "Ver todo"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Nº de productos",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "cols",
      "label": "Columnas (escritorio)",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Proporción de foto",
      "options": [
        {
          "value": "4/5",
          "label": "Vertical"
        },
        {
          "value": "1/1",
          "label": "Cuadrada"
        }
      ],
      "default": "4/5"
    },
    {
      "type": "select",
      "id": "fondo",
      "label": "Fondo",
      "options": [
        {
          "value": "blanco",
          "label": "Blanco"
        },
        {
          "value": "suave",
          "label": "Gris suave"
        },
        {
          "value": "marino",
          "label": "Marino"
        }
      ],
      "default": "blanco"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen arriba",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen abajo",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Productos destacados"
    }
  ]
}
{% endschema %}

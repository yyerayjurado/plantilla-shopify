<style>#shopify-section-{{ section.id }}{padding-top:{{ section.settings.padding_top | times: 0.6 | round }}px;padding-bottom:{{ section.settings.padding_bottom | times: 0.6 | round }}px}@media(min-width:750px){#shopify-section-{{ section.id }}{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}}</style>
<style>#shopify-section-{{ section.id }}{background:{% case section.settings.fondo %}{% when "suave" %}var(--soft){% when "marino" %}var(--navy);color:#fff{% else %}var(--bg){% endcase %}}</style>
{%- if section.settings.fondo == "marino" -%}<i class="on-dark" hidden></i>{%- endif -%}
<div class="page page--narrow" style="text-align:{{ section.settings.alineacion }}"><div class="sec-head" style="text-align:{{ section.settings.alineacion }}">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}{% if section.settings.heading != blank %}<h2 class="h2" style="--hs:{{ section.settings.heading_size }}px">{{ section.settings.heading }}</h2>{% endif %}{% if section.settings.subheading != blank %}<p class="sub">{{ section.settings.subheading }}</p>{% endif %}</div><div class="rte">{{ section.settings.text }}</div></div>
{% schema %}
{
  "name": "Texto",
  "class": "sec-text",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Título"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "select",
      "id": "alineacion",
      "label": "Alineación del título",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ],
      "default": "left"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Escribe aquí.</p>"
    },
    {
      "type": "select",
      "id": "fondo",
      "label": "Fondo",
      "options": [
        {
          "value": "blanco",
          "label": "Blanco"
        },
        {
          "value": "suave",
          "label": "Gris suave"
        },
        {
          "value": "marino",
          "label": "Marino"
        }
      ],
      "default": "blanco"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen arriba",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen abajo",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Texto"
    }
  ]
}
{% endschema %}

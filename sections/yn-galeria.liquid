<style>#shopify-section-{{ section.id }}{padding-top:{{ section.settings.padding_top | times: 0.6 | round }}px;padding-bottom:{{ section.settings.padding_bottom | times: 0.6 | round }}px}@media(min-width:750px){#shopify-section-{{ section.id }}{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}}</style>
<style>#shopify-section-{{ section.id }}{background:{% case section.settings.fondo %}{% when "suave" %}var(--soft){% when "marino" %}var(--navy);color:#fff{% else %}var(--bg){% endcase %}}</style>
{%- if section.settings.fondo == "marino" -%}<i class="on-dark" hidden></i>{%- endif -%}
<div class="page">
<div class="sec-row"><div class="sec-head" style="text-align:{{ section.settings.alineacion }}">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}{% if section.settings.heading != blank %}<h2 class="h2" style="--hs:{{ section.settings.heading_size }}px">{{ section.settings.heading }}</h2>{% endif %}{% if section.settings.subheading != blank %}<p class="sub">{{ section.settings.subheading }}</p>{% endif %}</div>{%- if settings.instagram != blank -%}<a class="link-arrow" target="_blank" rel="noopener" href="https://instagram.com/{{ settings.instagram | remove: '@' }}">{% render 'icon', name: 'instagram' %} @{{ settings.instagram | remove: '@' }}</a>{%- endif -%}</div>
<div class="gal">{%- for block in section.blocks -%}<a class="gal__it reveal" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,500,700', sizes: '(min-width: 990px) 17vw, 33vw' }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder' }}{%- endif -%}</a>{%- endfor -%}</div>
</div>
{% schema %}
{
  "name": "Galería Instagram",
  "class": "sec-gallery",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Síguenos"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Recién salido de la impresora"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "select",
      "id": "alineacion",
      "label": "Alineación del título",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "fondo",
      "label": "Fondo",
      "options": [
        {
          "value": "blanco",
          "label": "Blanco"
        },
        {
          "value": "suave",
          "label": "Gris suave"
        },
        {
          "value": "marino",
          "label": "Marino"
        }
      ],
      "default": "blanco"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen arriba",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen abajo",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "foto",
      "name": "Foto",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (post de Instagram o producto)"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Galería Instagram",
      "blocks": [
        {
          "type": "foto"
        },
        {
          "type": "foto"
        },
        {
          "type": "foto"
        },
        {
          "type": "foto"
        },
        {
          "type": "foto"
        },
        {
          "type": "foto"
        }
      ]
    }
  ]
}
{% endschema %}

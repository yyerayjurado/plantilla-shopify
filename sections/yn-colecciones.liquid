<style>#shopify-section-{{ section.id }}{padding-top:{{ section.settings.padding_top | times: 0.6 | round }}px;padding-bottom:{{ section.settings.padding_bottom | times: 0.6 | round }}px}@media(min-width:750px){#shopify-section-{{ section.id }}{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}}</style>
<style>#shopify-section-{{ section.id }}{background:{% case section.settings.fondo %}{% when "suave" %}var(--soft){% when "marino" %}var(--navy);color:#fff{% else %}var(--bg){% endcase %}}</style>
{%- if section.settings.fondo == "marino" -%}<i class="on-dark" hidden></i>{%- endif -%}
<div class="page"><div class="sec-head" style="text-align:{{ section.settings.alineacion }}">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}{% if section.settings.heading != blank %}<h2 class="h2" style="--hs:{{ section.settings.heading_size }}px">{{ section.settings.heading }}</h2>{% endif %}{% if section.settings.subheading != blank %}<p class="sub">{{ section.settings.subheading }}</p>{% endif %}</div>
<div class="cols-grid cols-grid--{{ section.blocks.size }}">
{%- for block in section.blocks -%}
{%- assign c = block.settings.collection -%}
<a class="col-card reveal" href="{{ block.settings.link | default: c.url | default: '#' }}" {{ block.shopify_attributes }}>
<div class="col-card__media">{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 990px) 25vw, 50vw' }}{%- elsif c.featured_image -%}{{ c.featured_image | image_url: width: 900 | image_tag: loading: 'lazy' }}{%- else -%}{{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder' }}{%- endif -%}</div>
<div class="col-card__info"><span class="col-card__t">{{ block.settings.title | default: c.title }}</span>{% render 'icon', name: 'arrow' %}</div>
</a>
{%- endfor -%}
</div></div>
{% schema %}
{
  "name": "Categorías",
  "class": "sec-cols",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Categorías"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Encuentra tu regalo"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "select",
      "id": "alineacion",
      "label": "Alineación del título",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "fondo",
      "label": "Fondo",
      "options": [
        {
          "value": "blanco",
          "label": "Blanco"
        },
        {
          "value": "suave",
          "label": "Gris suave"
        },
        {
          "value": "marino",
          "label": "Marino"
        }
      ],
      "default": "blanco"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen arriba",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen abajo",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "categoria",
      "name": "Categoría",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título (opcional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen (opcional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (opcional)"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Categorías",
      "blocks": [
        {
          "type": "categoria",
          "settings": {
            "title": "Navidad"
          }
        },
        {
          "type": "categoria",
          "settings": {
            "title": "Llaveros con nombre"
          }
        },
        {
          "type": "categoria",
          "settings": {
            "title": "Decoración"
          }
        },
        {
          "type": "categoria",
          "settings": {
            "title": "Encargos a medida"
          }
        }
      ]
    }
  ]
}
{% endschema %}
